<Window x:Class="ScriptForge.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScriptForge" Height="820" Width="620"
        ResizeMode="CanMinimize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="ScriptForge" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Convert PowerShell and batch scripts into standalone Windows executables"
                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Source -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Source" Style="{StaticResource SectionHeaderStyle}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="RbSingleFile" Content="Single script file" IsChecked="True"
                                         GroupName="SourceKind" Margin="0,0,20,0" Checked="SourceKind_Changed"/>
                            <RadioButton x:Name="RbFolder" Content="Folder (multiple scripts)"
                                         GroupName="SourceKind" Checked="SourceKind_Changed"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtInput" Grid.Column="0" Margin="0,0,8,0"/>
                            <Button x:Name="BtnBrowseInput" Grid.Column="1" Content="Browse"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowseInput_Click"/>
                        </Grid>

                        <StackPanel x:Name="EntryPanel" Visibility="Collapsed">
                            <TextBlock Text="Entry script (relative path inside the folder, e.g. main.ps1)"
                                       Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtEntry"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Output -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Output" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtOutput" Grid.Column="0" Margin="0,0,8,0"/>
                            <Button x:Name="BtnBrowseOutput" Grid.Column="1" Content="Browse"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowseOutput_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Metadata -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Metadata" Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Product name" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtProduct" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Author / Company" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtCompany" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Copyright" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtCopyright" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Description" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtDescription" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Version" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtVersion" Grid.Row="4" Grid.Column="1" Text="1.0.0.0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Icon -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Icon" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtIcon" Grid.Column="0" Margin="0,0,8,0"/>
                            <Button x:Name="BtnBrowseIcon" Grid.Column="1" Content="Browse" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowseIcon_Click"/>
                            <Image x:Name="IconPreview" Grid.Column="2" Width="28" Height="28"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Options -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Options" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox x:Name="ChkAdmin" Content="Require administrator privileges (UAC)" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkGui" Content="Windowed application — hide console window (no output)"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Build action -->
        <StackPanel Grid.Row="2" Margin="0,12,0,12">
            <TextBlock x:Name="TxtStatus" HorizontalAlignment="Center" Margin="0,0,0,8"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
            <Button x:Name="BtnBuild" Content="Build executable" Height="56" FontSize="16"
                    Style="{StaticResource PrimaryButtonStyle}" Click="BtnBuild_Click"/>
        </StackPanel>

        <!-- Log -->
        <Border Grid.Row="3" Background="#111827" CornerRadius="8" Padding="10">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                         Background="Transparent" Foreground="#D1D5DB" FontFamily="Consolas" FontSize="11.5"/>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
